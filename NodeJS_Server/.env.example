// Example .env file for local development
// Copy this to .env and fill in your values

# Server Configuration
PORT=3000
WS_PORT=3001
NODE_ENV=development

# Local MQTT Broker (for development)
MQTT_BROKER=mqtt://10.137.147.176
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# HiveMQ Cloud (for production)
# MQTT_BROKER=abc123xyz.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USERNAME=your-hivemq-username
# MQTT_PASSWORD=your-hivemq-password

# PostgreSQL Database Configuration
# Format: postgresql://username:password@host:port/database
# Example từ Render: postgresql://iot_user:xxxxx@dpg-xxxxx.singapore-postgres.render.com/iot_db
DATABASE_URL=postgresql://localhost:5432/iot_db

# Hoặc cấu hình riêng lẻ (tùy chọn)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=iot_db
# DB_USER=postgres
# DB_PASSWORD=your_password

